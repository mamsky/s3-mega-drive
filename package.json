{
  "name": "mega-drive-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Backend REST API + S3 gateway untuk MEGA (mega.nz): upload, list, streaming view, delete, dan protokol S3 (SigV4)",
  "scripts": {
    "start": "bun run src/server.js",
    "dev": "bun --watch run src/server.js",
    "s3": "bun run src/s3/server.js",
    "s3:dev": "bun --watch run src/s3/server.js",
    "ui": "bun run src/ui/server.js",
    "ui:dev": "bun --watch run src/ui/server.js",
    "smoke": "bun run test/smoke.mjs",
    "s3:smoke": "bun run test/s3-smoke.mjs",
    "s3:sdk": "bun run test/s3-sdk.mjs",
    "s3:identity": "bun run test/s3-identity.mjs",
    "ui:smoke": "bun run test/ui-smoke.mjs"
  },
  "dependencies": {
    "hono": "^4.13.12",
    "megajs": "^1.3.10",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@aws-sdk/client-s3": "^3.1162.0",
    "@aws-sdk/s3-request-presigner": "^3.1162.0"
  }
}
