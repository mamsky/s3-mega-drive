# Template .env untuk VPS. Salin ke /opt/s3-mega-drive/.env lalu isi nilainya.
#
#   sudo nano /opt/s3-mega-drive/.env
#   sudo chmod 600 /opt/s3-mega-drive/.env
#
# Jangan commit file ini. Baris IMAGE= diisi otomatis oleh CI setiap deploy,
# jadi tidak perlu ditulis di sini.

# ---------- AKUN MEGA (wajib) ----------
MEGA_EMAIL=
MEGA_PASSWORD=
MEGA_2FA=

# ---------- DOMAIN ----------
S3_DOMAIN=s3.pasteprosmana.my.id

# ---------- IDENTITAS S3 ----------
# Buat dengan: openssl rand -hex 20  dan  openssl rand -hex 32
# Harus diisi, kalau kosong /__health mengembalikan 503 dan CI menganggap
# deploy gagal.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# Password login console web sebagai identitas "default".
S3_UI_PASSWORD=

# ---------- PORT ----------
# Hanya di-bind ke 127.0.0.1, jadi tidak terbuka ke internet.
S3_PORT=3001
S3_UI_PORT=3002
PORT=3000

# ---------- JANGAN ISI DATABASE_URL ----------
# Kalau diisi dengan 127.0.0.1, gateway crash saat start karena di dalam
# container alamat itu tidak ada. Biarkan kosong untuk mode file.
# DATABASE_URL=
