# Template konfigurasi MEGA Drive API (format KEY=VALUE).
# Cara pakai: salin file ini menjadi env.local, lalu isi nilainya.
#   Copy-Item env.example env.local
# env.local otomatis dibaca saat server start dan sudah masuk .gitignore.
#
# Semua variabel di bawah dipakai kode. Yang dikosongkan berarti memakai nilai
# default yang tertulis di komentarnya.

# ---------- AKUN MEGA (wajib) ----------
MEGA_EMAIL=email-kamu@contoh.com
MEGA_PASSWORD=password-mega-kamu
# Hanya untuk akun dengan 2FA.
MEGA_2FA=

# ---------- REST API ----------
# Default 3000.
PORT=3000

# ---------- DATABASE (opsional) ----------
# Kalau diisi, identitas S3, metadata objek, dan state multipart disimpan di
# PostgreSQL. File aslinya tetap di MEGA. Kalau kosong, semuanya memakai file
# lokal seperti sebelumnya - aplikasi tetap jalan penuh.
#
# Dua format diterima:
#   jdbc:postgresql://127.0.0.1:5432/s3_mega_drive?user=user&password=rahasia
#   postgres://user:rahasia@127.0.0.1:5432/s3_mega_drive
#
# Tabel dibuat otomatis saat start. Saat tabel identities masih kosong, isi
# s3-identities.local.json disalin sekali ke database.
DATABASE_URL=

# ---------- S3 GATEWAY (opsional) ----------
# Jalankan dengan: bun run s3
# Default 3001.
S3_PORT=3001
# Default 0.0.0.0. Pakai 127.0.0.1 kalau hanya untuk lokal.
S3_HOSTNAME=0.0.0.0
# Harus sama di klien dan server.
S3_REGION=us-east-1
# Wajib true untuk hampir semua klien S3 saat endpoint bukan AWS.
S3_FORCE_PATH_STYLE=true
# Default true.
S3_AUTO_CREATE_BUCKET=true
# Default false. Biarkan false supaya upload kecil lewat multipart tetap jalan.
S3_STRICT_PART_SIZE=false
# Toleransi selisih jam klien vs server, detik. Default 900.
S3_MAX_CLOCK_SKEW=900
# Batas ukuran body request, byte. Default 5 GB.
S3_MAX_BODY_BYTES=5368709120
# Batas body yang dicek checksum x-amz-content-sha256, byte. Default 16 MB.
# Body lebih besar dilewatkan tanpa verifikasi hash agar hemat memori.
S3_VERIFY_MAX_BYTES=16777216

# ---------- IDENTITAS ----------
# Identitas disimpan di tabel identities (kalau DATABASE_URL diisi) atau di
# s3-identities.local.json (lihat s3-identities.example.json). Tiap identitas
# punya ruang MEGA sendiri (s3/<nama>/) dan tidak bisa saling melihat data.
#
# Nama file identitas alternatif, relatif ke folder project. Berguna untuk
# testing supaya tidak mengganggu file asli. Default s3-identities.local.json.
# S3_IDENTITIES_FILE=s3-identities.local.json
#
# Dua variabel di bawah hanya cadangan kalau database dan file identitas
# sama-sama kosong: gateway memakai SATU identitas "default" (s3/default/).
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# ---------- CONSOLE WEB (opsional) ----------
# Jalankan dengan: bun run ui
# Password console untuk identitas cadangan di atas. Di-hash argon2id.
S3_UI_PASSWORD=
# Default 3002 dan 127.0.0.1.
S3_UI_PORT=3002
S3_UI_HOSTNAME=127.0.0.1
# Kunci tanda tangan cookie sesi. Kosong = acak saat start (sesi hilang tiap
# restart). Isi string acak panjang kalau ingin sesi bertahan.
S3_UI_SECRET=
# Batas ukuran upload lewat console, byte. Default 5 GB.
S3_UI_MAX_BODY_BYTES=5368709120
# Endpoint S3 yang ditampilkan di halaman console. Kosong = otomatis
# http://<host>:<S3_PORT>. Isi kalau gateway diakses lewat domain/reverse proxy.
S3_PUBLIC_ENDPOINT=
